version: 1

application:
  name: __NAME__
  identifier: __APP_ID__
  version: 0.1.0
  build: 1

commands:
  web: ./cmd/wasm
  server: ./cmd/server
  desktop: ./cmd/desktop
  mobile: ./cmd/mobile
  tui: ./cmd/tui

targets:
  web:
    output: web
  ios:
    minimum_version: "13.0"
  android:
    minimum_sdk: 26
    target_sdk: 36
  desktop:
    toolchains:
      darwin-amd64:
        cc: clang
        cxx: clang++
        cflags: "-arch x86_64"
        cxxflags: "-arch x86_64"
        ldflags: "-arch x86_64"
      darwin-arm64:
        cc: clang
        cxx: clang++
        cflags: "-arch arm64"
        cxxflags: "-arch arm64"
        ldflags: "-arch arm64"
