package main

import (
	"log"
	"net/http"

	app "__MODULE__"
	quicken "goforge.dev/quicken/web"
)

func main() {
	mux := http.NewServeMux()
	mux.Handle("/", quicken.FullPageProgram[app.Bootstrap, app.Model, app.Msg]{
		MountID: "app", Program: app.WebProgram(),
	})
	mux.Handle("/assets/", http.StripPrefix("/assets/", http.FileServer(http.Dir("web"))))
	log.Println("__NAME__ listening on :8080")
	log.Fatal(http.ListenAndServe(":8080", mux))
}
